                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "t"
              ]
            },
            "q1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I care for a silk saree?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Dry clean only, and only when it needs it — silk does not like frequent cleaning. Store it folded in a cotton cloth rather than plastic, and refold along different lines every few months so the zari does not crack where it creases.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
