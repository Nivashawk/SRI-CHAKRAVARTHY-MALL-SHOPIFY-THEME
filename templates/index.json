          },
          "blocks": {
            "q0": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Does the saree come with a blouse piece?",
                "open_by_default": true,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Every saree includes an unstitched blouse piece attached at the pallu end, unless the product page says otherwise. Stitching is not included.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
