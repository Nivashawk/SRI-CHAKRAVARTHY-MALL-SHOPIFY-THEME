{% comment %}
  The customer account page — profile and orders, for a customer who is already
  signed in. Signing in itself happens in the popup (snippets/scm-login-dialog),
  which opens over whatever page the customer was on.

  Everything inside is rendered by assets/account.js, which talks straight to
  Odoo — the shop's identity provider, shared with their POS, rewards and
  invoicing. Shopify's own customer accounts are not used: on this plan they
  cannot accept an outside login, and they always require an email, which a
  phone-first customer may not have.

  The styles for all of this live in assets/custom.css, not in a
  {% stylesheet %} here, because the popup needs them on every page and a
  section's stylesheet only loads with the section.
{% endcomment %}

<div
  class="scm-account"
  data-account-area
  data-api-base="{{ section.settings.api_base_url }}"
>
  <div data-account-body>
    <noscript>
      <h1 class="scm-account__title">{{ 'account.signin_title' | t }}</h1>
      <p class="scm-account__lead">{{ 'account.signin_noscript' | t }}</p>
    </noscript>
  </div>
</div>

<script src="{{ 'account.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Customer account",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Profile and orders for a signed-in customer. Signing in happens in a popup, which opens from the account icon in the header. Add ?mock=1 to the page URL to demo the screens with sample data."
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "Odoo address",
      "default": "https://altbriterai.brite.app",
      "info": "No trailing slash. Odoo must allow this store's domain (CORS) or every request fails."
    }
  ],
  "presets": [
    {
      "name": "Customer account"
    }
  ]
}
{% endschema %}
