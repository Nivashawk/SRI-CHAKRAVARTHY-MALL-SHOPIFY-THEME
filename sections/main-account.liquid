{% comment %}
  The customer account area.

  Everything inside is rendered by assets/account.js, which talks straight to
  Odoo — the shop's identity provider, shared with their POS, rewards and
  invoicing. Shopify's own customer accounts are not used here: on this plan
  they cannot accept an outside login, and they always require an email, which
  a phone-first customer may not have.

  The markup below is only the shell and the no-JavaScript fallback.

  CLASS NAMES: everything here is prefixed `scm-`. The theme already owns
  `.account-button` (snippets/header-actions.liquid sets it transparent), and
  an earlier version of this file used the same name — which silently stripped
  the gold off the submit button. Keep the prefix.

  COLOURS: written out rather than taken from theme variables. `--font-size-h3`
  does not exist in this theme, so the heading fell back to body size. The
  values below come from assets/custom.css, which records why each one is what
  it is.
{% endcomment %}

{% liquid
  assign border_image = section.settings.border_image
  assign crop = section.settings.border_crop | default: 'center'
%}

<div
  class="scm-account"
  data-account-area
  data-api-base="{{ section.settings.api_base_url }}"
>
  {%- comment -%}
    The strip is cropped by CSS (object-fit: cover), not by image_url. Asking
    Shopify for a tall narrow crop does not work here: it will not upscale, so
    a request for 420×1800 from a 1200×1600 photograph comes back as the whole
    picture at 420 wide. The browser crops reliably at any container height.
  {%- endcomment -%}
  <div class="scm-account__border" aria-hidden="true">
    {% if border_image %}
      <img
        src="{{ border_image | image_url: width: 500 }}"
        srcset="
          {{ border_image | image_url: width: 500 }} 500w,
          {{ border_image | image_url: width: 900 }} 900w
        "
        sizes="(min-width: 750px) 180px, 100vw"
        alt=""
        loading="eager"
        width="{{ border_image.width }}"
        height="{{ border_image.height }}"
        style="object-position: {{ crop }};"
      >
    {% endif %}
  </div>

  <div class="scm-account__body" data-account-body>
    <noscript>
      <h1 class="scm-account__title">{{ 'account.signin_title' | t }}</h1>
      <p class="scm-account__lead">{{ 'account.signin_noscript' | t }}</p>
    </noscript>
  </div>
</div>

<script src="{{ 'account.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* Sri Chakravarthy — sign-in and account area.

     The one bold thing is the woven border down the left edge; everything
     beside it stays quiet. Corners follow the storefront, which is square:
     2px on buttons, 4px on inputs, 0 on panels. */

  .scm-account {
    --scm-ivory: #fdfaf0;
    --scm-ink: #221e1a;
    --scm-gold-text: #6b4e10; /* 7.39:1 on ivory */
    --scm-gold-rule: #9a6b17; /* 4.48:1 — hairlines and icons only */
    --scm-gold-fill: #d9982f; /* decorative; never as text on ivory */
    --scm-oat: #e7dfd2;
    --scm-measure: 26rem;

    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    min-height: 32rem;
    background: var(--scm-ivory);
    color: var(--scm-ink);

    /* Full bleed, out of the page's column, while the header and footer stay. */
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  /* The woven border, drawn rather than photographed.
   *
   * A photograph was tried first and does not work at this width: the shop's
   * saree pictures are full-length portraits, so a 180px column crops to a
   * whole person squeezed into a slit, face included. What belongs here is the
   * zari — the woven gold edge of the saree — so it is drawn directly: a dark
   * ground, a gold rail each side, and the rhythmic cross-weave between them.
   *
   * A merchant who wants a photograph can still set one in the editor; it is
   * laid over this. */
  .scm-account__border {
    position: relative;
    overflow: hidden;
    background-color: #1b1a2e;
    background-image:
      /* The weave: a broad gold band, a fine companion line, then a plain
         field. Drawn and checked at the real 180px width — tighter spacing
         reads as a barcode rather than cloth. */
      repeating-linear-gradient(
        180deg,
        rgb(217 152 47 / 86%) 0 6px,
        transparent 6px 10px,
        rgb(217 152 47 / 47%) 10px 12px,
        transparent 12px 36px,
        rgb(231 223 210 / 31%) 36px 38px,
        transparent 38px 72px
      ),
      /* a gold rail down each edge, as on a real border */
      linear-gradient(
        90deg,
        #b8801f 0 4px,
        transparent 4px calc(100% - 11px),
        rgb(217 152 47 / 47%) calc(100% - 11px) calc(100% - 9px),
        transparent calc(100% - 9px) calc(100% - 8px),
        #b8801f calc(100% - 8px) 100%
      );
  }

  /* On a phone the strip lies across the top, so the weave turns with it. */
  @media screen and (max-width: 749px) {
    .scm-account__border {
      background-image:
        repeating-linear-gradient(
          90deg,
          rgb(217 152 47 / 86%) 0 6px,
          transparent 6px 10px,
          rgb(217 152 47 / 47%) 10px 12px,
          transparent 12px 36px,
          rgb(231 223 210 / 31%) 36px 38px,
          transparent 38px 72px
        ),
        linear-gradient(
          180deg,
          #b8801f 0 4px,
          transparent 4px calc(100% - 8px),
          #b8801f calc(100% - 8px) 100%
        );
    }
  }

  .scm-account__border img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scm-account__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: 64px clamp(24px, 6vw, 80px);
  }

  .scm-account__title {
    max-width: var(--scm-measure);
    margin: 0;
    font-family: var(--font-heading--family, 'Cormorant', Georgia, serif);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .scm-account__lead {
    max-width: var(--scm-measure);
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.75; /* 7.08:1 on ivory, per custom.css */
  }

  .scm-account__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    max-width: var(--scm-measure);
    margin-block-start: 8px;
  }

  .scm-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .scm-field__label {
    font-size: 0.875rem;
    color: var(--scm-gold-text);
  }

  .scm-field__input {
    min-height: 52px;
    padding: 12px 16px;
    font-family: inherit;
    font-size: 1rem;
    color: var(--scm-ink);
    background: #fff;
    border: 1px solid rgb(34 30 26 / 28%);
    border-radius: 4px;
  }

  .scm-field__input::placeholder {
    color: rgb(34 30 26 / 45%);
  }

  .scm-field__input:focus-visible {
    outline: 2px solid var(--scm-gold-rule);
    outline-offset: 2px;
    border-color: var(--scm-gold-rule);
  }

  .scm-field__input--code {
    font-size: 1.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5em;
    text-indent: 0.5em; /* keeps the tracking from pushing digits off-centre */
    text-align: center;
  }

  .scm-button {
    min-height: 52px;
    padding: 14px 28px;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--scm-ink); /* 6.69:1 on the gold; white would be 2.5:1 */
    background: var(--scm-gold-fill);
    border: none;
    border-radius: 2px;
    cursor: pointer;
  }

  .scm-button:hover {
    background: #c9892a;
  }

  .scm-button:focus-visible {
    outline: 2px solid var(--scm-ink);
    outline-offset: 2px;
  }

  .scm-button[disabled] {
    opacity: 0.55;
    cursor: default;
  }

  .scm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    max-width: var(--scm-measure);
  }

  .scm-actions--stacked {
    flex-direction: column;
    gap: 14px;
    margin-block-start: 12px;
    padding-block-start: 22px;
    border-block-start: 1px solid rgb(34 30 26 / 15%);
  }

  .scm-link {
    align-self: flex-start;
    min-height: 44px;
    padding: 0;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--scm-gold-text);
    background: none;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .scm-link--quiet {
    color: var(--scm-ink);
    opacity: 0.75;
  }

  .scm-link:focus-visible {
    outline: 2px solid var(--scm-gold-rule);
    outline-offset: 3px;
  }

  .scm-error {
    max-width: var(--scm-measure);
    margin: 0;
    padding: 12px 16px;
    font-size: 0.9375rem;
    color: #7a1f12; /* 8.1:1 on its tint */
    background: #fbede7;
    border-inline-start: 3px solid #7a1f12;
  }

  .scm-note {
    margin: 0;
    font-size: 0.9375rem;
    color: #2f5d3a;
  }

  .scm-demo {
    max-width: var(--scm-measure);
    margin: 0 0 4px;
    padding: 12px 16px;
    font-size: 0.875rem;
    color: #5a3e00;
    background: #fff4d6;
    border: 1px dashed var(--scm-gold-rule);
  }

  /* --- signed in: tabs, profile, orders --- */

  .scm-nav {
    display: flex;
    gap: 2px;
    max-width: 44rem;
    margin-block-end: 4px;
    border-block-end: 1px solid rgb(34 30 26 / 15%);
  }

  .scm-tab {
    min-height: 44px;
    padding: 0 18px;
    font-family: inherit;
    font-size: 1rem;
    color: var(--scm-ink);
    opacity: 0.75;
    background: none;
    border: none;
    border-block-end: 2px solid transparent;
    cursor: pointer;
  }

  .scm-tab--current {
    opacity: 1;
    font-weight: 600;
    color: var(--scm-gold-text);
    border-block-end-color: var(--scm-gold-rule);
  }

  .scm-tab:focus-visible {
    outline: 2px solid var(--scm-gold-rule);
    outline-offset: -2px;
  }

  .scm-orders {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 44rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scm-order {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 18px 20px;
    background: #fff;
    border: 1px solid rgb(34 30 26 / 14%);
  }

  .scm-order__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }

  .scm-order__number {
    font-weight: 600;
  }

  .scm-order__status {
    font-size: 0.875rem;
    color: var(--scm-gold-text);
  }

  .scm-order__meta {
    margin: 0;
    font-size: 0.9375rem;
    opacity: 0.75;
  }

  .scm-order__items {
    margin: 0;
    padding-inline-start: 1.1em;
    font-size: 0.9375rem;
  }

  /* Once signed in the border steps aside: the account needs the width more
     than it needs the decoration. */
  .scm-account--in {
    grid-template-columns: 8px minmax(0, 1fr);
  }

  .scm-account--in .scm-account__border img {
    display: none;
  }

  .scm-account--in .scm-account__form,
  .scm-account--in .scm-account__title,
  .scm-account--in .scm-account__lead {
    max-width: 34rem;
  }

  /* One moment of motion: the step change. Nothing on load, nothing on hover. */
  @media (prefers-reduced-motion: no-preference) {
    .scm-step {
      animation: scm-step-in 220ms ease-out;
    }
  }

  @keyframes scm-step-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media screen and (max-width: 749px) {
    .scm-account {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 72px minmax(0, 1fr);
      min-height: 0;
    }

    .scm-account--in {
      grid-template-rows: 6px minmax(0, 1fr);
    }

    .scm-account__body {
      padding: 36px 24px 56px;
    }

    .scm-account__title {
      font-size: 2.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer account",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sign-in and profile, served by the shop's Odoo system. Add ?mock=1 to the page URL to demo the screens with sample data."
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "Odoo address",
      "default": "https://altbriterai.brite.app",
      "info": "No trailing slash. Odoo must allow this store's domain (CORS) or every request fails."
    },
    {
      "type": "header",
      "content": "Woven border"
    },
    {
      "type": "image_picker",
      "id": "border_image",
      "label": "Border image",
      "info": "Optional. Leave empty for the drawn zari band, which suits the narrow strip better. A full-length saree photograph crops to a slit at this width, so use a close-up of a border if you set one."
    },
    {
      "type": "select",
      "id": "border_crop",
      "label": "Which part of the photo to keep",
      "options": [
        { "value": "center top", "label": "Top of the saree" },
        { "value": "center", "label": "Middle" },
        { "value": "center bottom", "label": "Border and pleats" },
        { "value": "left", "label": "Left edge" },
        { "value": "right", "label": "Right edge" }
      ],
      "default": "center",
      "info": "The strip is narrow, so check the crop does not land on a face or a blank wall."
    }
  ],
  "presets": [
    {
      "name": "Customer account"
    }
  ]
}
{% endschema %}
