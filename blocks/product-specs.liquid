{% doc %}
  A specification table for the product page, read from the product's
  `specs.*` metafields (Colour, Weave, Saree length, Blouse piece, Zari,
  Occasion, Weight).

  The client edits the values as pinned fields on the product in Admin, so this
  block needs no per-product editing and never holds content itself.

  Empty fields are skipped rather than rendered blank, which is deliberate:
  `zari`, `length` and `weight` ship empty because nobody has supplied real
  values, and the homepage FAQ promises zari is stated honestly per product. A
  row only appears once someone fills it in.

  Care is the exception -- it is the same sentence for every silk saree, so the
  block carries a default and the product metafield overrides it only when a
  saree needs different wording.
{% enddoc %}

{%- liquid
  assign product = closest.product
  assign spec_keys = 'colour,weave,length,blouse,zari,occasion,weight' | split: ','
  assign spec_labels = 'Colour,Weave,Saree length,Blouse piece,Zari,Occasion,Weight' | split: ','

  assign care_text = product.metafields.specs.care.value | default: block.settings.care_default

  # Work out whether anything at all will render, so an unconfigured product
  # does not leave a heading with nothing under it.
  assign filled_count = 0
  for key in spec_keys
    if product.metafields.specs[key].value != blank
      assign filled_count = filled_count | plus: 1
    endif
  endfor
  if care_text != blank
    assign filled_count = filled_count | plus: 1
  endif
-%}

{%- if filled_count > 0 -%}
  <div
    class="product-specs spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <h2 class="product-specs__heading">{{ block.settings.heading }}</h2>
    {%- endif -%}

    <dl class="product-specs__list">
      {%- for key in spec_keys -%}
        {%- assign value = product.metafields.specs[key].value -%}
        {%- if value != blank -%}
          <div class="product-specs__row">
            <dt class="product-specs__label">{{ spec_labels[forloop.index0] }}</dt>
            <dd class="product-specs__value">{{ value }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if care_text != blank -%}
        <div class="product-specs__row">
          <dt class="product-specs__label">Care</dt>
          <dd class="product-specs__value">{{ care_text }}</dd>
        </div>
      {%- endif -%}
    </dl>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-specs__heading {
    font-size: var(--font-size--h6);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--padding-sm);
  }

  .product-specs__list {
    margin: 0;
    display: grid;
    gap: var(--padding-xs);
  }

  /* Two columns on anything roomy, stacked on a phone -- a 90px label column
     keeps the values aligned without truncating "Saree length". */
  .product-specs__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding-block-end: var(--padding-xs);
    border-block-end: 1px solid var(--color-border);
  }

  .product-specs__row:last-child {
    border-block-end: none;
    padding-block-end: 0;
  }

  @media screen and (min-width: 500px) {
    .product-specs__row {
      grid-template-columns: 9rem 1fr;
      gap: var(--padding-sm);
    }
  }

  .product-specs__label {
    color: var(--color-foreground-muted);
    font-size: 0.875rem;
  }

  .product-specs__value {
    margin: 0;
    font-size: 0.9375rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product details",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Product details"
    },
    {
      "type": "textarea",
      "id": "care_default",
      "label": "Default care text",
      "info": "Shown when a product has no Care value of its own.",
      "default": "Dry clean only. Store folded in a cotton cloth rather than plastic, and refold along different lines every few months."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
