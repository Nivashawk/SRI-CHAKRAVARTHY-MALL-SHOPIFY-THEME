{% assign block_settings = block.settings %}
{% comment %} Guard the comparison below: a nil rating would otherwise be compared against a number. {% endcomment %}
{% assign rating = block_settings.rating | default: 0 %}

{% if block_settings.background_color != blank or block_settings.text_color != blank %}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    section_id: block.id
  %}
{% endif %}

<div
  class="testimonial spacing-style testimonial--{{ block_settings.alignment }}{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.star_color != blank %}--testimonial-star-color: {{ block_settings.star_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- if rating > 0 -%}
    <div
      class="testimonial__rating"
      role="img"
      aria-label="{{ rating }} / 5"
    >
      {%- for i in (1..5) -%}
        <span class="testimonial__star{% if i > rating %} testimonial__star--empty{% endif %}" aria-hidden="true">★</span>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if block_settings.quote != blank -%}
    <blockquote class="testimonial__quote text-block">{{ block_settings.quote }}</blockquote>
  {%- endif -%}

  {%- if block_settings.image != blank or block_settings.author != blank or block_settings.author_detail != blank -%}
    <figcaption class="testimonial__author">
      {%- if block_settings.image != blank -%}
        {{
          block_settings.image
          | image_url: width: 120
          | image_tag:
            loading: 'lazy',
            width: 60,
            height: 60,
            class: 'testimonial__avatar',
            alt: block_settings.author
        }}
      {%- endif -%}

      {%- if block_settings.author != blank or block_settings.author_detail != blank -%}
        <div class="testimonial__author-text">
          {%- if block_settings.author != blank -%}
            <span class="testimonial__author-name">{{ block_settings.author }}</span>
          {%- endif -%}
          {%- if block_settings.author_detail != blank -%}
            <span class="testimonial__author-detail">{{ block_settings.author_detail }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </figcaption>
  {%- endif -%}
</div>

{% stylesheet %}
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .testimonial--center {
    align-items: center;
    text-align: center;
  }

  .testimonial--flex-end {
    align-items: flex-end;
    text-align: end;
  }

  .testimonial__quote {
    margin: 0;
  }

  .testimonial__rating {
    letter-spacing: 2px;
    line-height: 1;
    color: var(--testimonial-star-color, inherit);
  }

  .testimonial__star--empty {
    opacity: var(--opacity-25, 0.25);
  }

  .testimonial__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block-start: auto;
  }

  .testimonial--center .testimonial__author {
    justify-content: center;
  }

  .testimonial--flex-end .testimonial__author {
    justify-content: flex-end;
  }

  .testimonial__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .testimonial__author-text {
    display: flex;
    flex-direction: column;
  }

  .testimonial__author-name {
    font-weight: 600;
  }

  .testimonial__author-detail {
    color: var(--color-foreground-muted, inherit);
    font-size: var(--font-size--sm, 0.875rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.testimonial",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "quote",
      "label": "t:settings.quote",
      "default": "<p>Add a customer quote here.</p>"
    },
    {
      "type": "text",
      "id": "author",
      "label": "t:settings.author"
    },
    {
      "type": "text",
      "id": "author_detail",
      "label": "t:settings.author_detail"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:settings.rating",
      "info": "t:info.rating_zero_hides",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:settings.star_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.testimonial"
    }
  ]
}
{% endschema %}
